{
  "name": "cepheland-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Cepheland — Tarafını seç. Cepheni kazan. Konum tabanlı stratejik sosyal fetih oyunu",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:all": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @cepheland/api dev",
    "dev:worker": "pnpm --filter @cepheland/worker dev",
    "dev:admin": "pnpm --filter @cepheland/admin dev",
    "dev:mobile": "pnpm --filter @cepheland/mobile dev",
    "dev:showcase": "pnpm --filter @cepheland/showcase dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "pnpm --filter @cepheland/game-rules test && pnpm --filter @cepheland/geo test",
    "test:integration": "pnpm --filter @cepheland/api test:integration",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@turf/helpers": "^7.4.0",
    "@turf/polygonize": "^7.4.0",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "is-sea": "^0.3.1"
  }
}
