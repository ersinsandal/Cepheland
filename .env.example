# Optional API configuration. Copy to apps/api/.env before `pnpm dev:api`.
# These settings do not turn the demonstration server into a production service.
NODE_ENV=development
PORT=3001

# Use a locally generated value; never commit your actual signing secret.
JWT_SECRET=replace-with-a-locally-generated-signing-secret

# Optional Overpass-compatible endpoints, separated by commas.
OSM_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter

# Omit these to use apps/api/scratch. Relative paths use the API working directory.
# OSM_CACHE_DIR=
# PARCEL_CACHE_DIR=
# FRONT_NAMES_FILE=

# Optional Photon-compatible place search service.
# PLACE_SEARCH_URL=https://photon.komoot.io/api/

# Mobile configuration belongs in apps/mobile/.env.local, not apps/api/.env.
# VITE_API_BASE_URL=http://localhost:3001
